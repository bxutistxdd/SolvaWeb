# Variables de entorno para Solva (plantilla base).
# Copia a .env (ignorado por git) o configúralas como Secrets del repo para
# el workflow de GitHub Actions. NUNCA committear valores reales.

# Supabase del proyecto de esta instancia (Settings → API en el dashboard
# de Supabase). La anon/publishable key es pública por diseño — las
# políticas RLS son las que protegen las escrituras.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# El WhatsApp del negocio y demás datos de marca NO se leen de variables de
# entorno: se configuran en src/lib/brand.js (placeholder inicial) y pueden
# sobrescribirse desde el panel admin → Config (tabla `settings`, clave
# wa_phone).
